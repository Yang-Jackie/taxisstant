# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored: API keys live only there, never in code, never in git, and never reach the client (NF-2.2).

# LTA DataMall AccountKey — sent as the "AccountKey" header on every LTA request
LTA_ACCOUNT_KEY=

# Every setting below is optional: leave it empty (or delete it) for the default. ServerConfig.ts checks them all.

# Port the data service listens on (default 3000)
PORT=3000

# Sites allowed to call the API from another origin, comma-separated, e.g. https://taxi.example (default: none,
# for when this server also serves the app, so the browser sees one origin)
CORS_ORIGINS=

# How many proxies sit in front of the server, e.g. 1 behind nginx (default 0), so the rate limit sees real clients
TRUST_PROXY=

# Requests each client address may make per minute (default 300)
RATE_LIMIT_PER_MINUTE=
